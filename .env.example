# Copy this file to .env.local for local development. Never commit real
# credentials or machine-specific project configuration. Production values
# are supplied by the hosting provider / Cloudflare environment.

# --- Supabase public client configuration ---
# Use the Seeparah project values for your environment.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase server-only ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (primary translation provider) ---
# Server-only. Never prefix with VITE_ or NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-flash-latest

# --- Admin / support ---
SUPPORT_RATE_LIMIT_PEPPER=
SUPPORT_NOTIFICATION_TO=
SUPPORT_NOTIFICATION_FROM=
RESEND_API_KEY=
SUPPORT_RATE_LIMIT_SALT=
