# Copy the server-only secrets you need into .env.local (already gitignored
# via the *.local rule in .gitignore) — never put real values in this file
# or in .env, which is tracked in git.

# --- Supabase (public values live in the tracked .env; these do not) ---
SUPABASE_SERVICE_ROLE_KEY=
# Already present in the tracked .env for this project:
# SUPABASE_URL=, SUPABASE_PUBLISHABLE_KEY=, VITE_SUPABASE_URL=, VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Gemini (primary translation provider) ---
# Server-only. Never prefix with VITE_ or NEXT_PUBLIC_ — those are exposed
# to the browser bundle. The key's display name in Google AI Studio
# ("Seeparah Website Translation") is unrelated to this variable name.
GEMINI_API_KEY=
# Defaults to Google's rolling "latest flash" alias if unset. Pin to a
# specific dated model (e.g. gemini-3.8-flash) instead if you want
# reproducible behavior rather than automatic upgrades.
GEMINI_TRANSLATION_MODEL=gemini-flash-latest

# --- Admin surface (see docs/admin-operator-guide.md) ---
# Optional. Mixed into the hashed IP used to rate-limit the public,
# unauthenticated "can't sign in" support report form. Safe to leave unset.
SUPPORT_RATE_LIMIT_PEPPER=

# --- Support/copyright form notifications (see docs/admin-operator-guide.md) ---
# Server-only. Never put the real value in this file, in .env, or in chat —
# see src/lib/support-notification.server.ts for why: the recipient is read
# from this exact env var name in exactly one server-only file and is never
# returned to the browser.
SUPPORT_NOTIFICATION_TO=
# A verified sender address on a domain you control in Resend. Shown to
# whoever receives the notification email as the "from" address.
SUPPORT_NOTIFICATION_FROM=
# https://resend.com/api-keys — server-only, used via a direct fetch() call
# to Resend's HTTPS API (no SDK dependency).
RESEND_API_KEY=
# Optional. Mixed into the hashed IP used to rate-limit the public support
# and copyright forms — deliberately a separate value from
# SUPPORT_RATE_LIMIT_PEPPER above (which is only for the older, unrelated
# "can't sign in" report path), so introducing this doesn't change that
# existing flow's behavior. Safe to leave unset.
SUPPORT_RATE_LIMIT_SALT=
